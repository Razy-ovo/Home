---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="作品">
  <div class="works">
    <header class="heading">
      <div><p>SELECTED WORK / 我的作品</p><h1>把想法，<br /><span>做成真正能用的东西。</span></h1></div>
      <strong>02 <small>REAL PROJECTS</small></strong>
    </header>
    <section class="work-grid">
      <article class="work-card glass"><div class="visual ai"><b>01</b><i>AI</i><em>◌</em><small>NATURAL CONVERSATION</small></div><div class="copy"><label>01 / AI APPLICATION</label><h2>RazyAI <span>- Chat</span></h2><p>让智能思考跨越平台边界，以先进 AI 驱动自然对话，构建属于你的全场景智能交互中枢。</p><a href="mailto:razy-ovo@outlook.com?subject=RazyAI%20-%20Chat">联系了解 ↗</a></div></article>
      <article class="work-card glass reverse"><div class="copy"><label>02 / PERSONAL SPACE</label><h2>Razy <span>个人主页</span></h2><p>面向个人的轻量化主页系统。</p><a href="/contact/">联系我 ↗</a></div><div class="visual home"><b>02</b><i>R</i><em></em><small>LIGHTWEIGHT PERSONAL SPACE</small></div></article>
    </section>
    <footer><span>ONLY REAL WORK</span><p>目前只有这两项，新的作品完成后再继续更新。</p></footer>
  </div>
</BaseLayout>
<style>
  .works{width:min(1100px,calc(100% - 40px));margin:auto}.heading{position:relative;animation:in-left .7s both}.heading p,.copy label{color:#b8c9eb;font-size:10px;font-weight:750;letter-spacing:.13em}.heading h1{margin:18px 0 0;font-size:clamp(48px,6.2vw,82px);line-height:.99;letter-spacing:-.047em}.heading h1 span,.copy h2 span{color:#b9caf1}.heading strong{position:absolute;right:0;bottom:3px;padding:18px;display:grid;gap:6px;border-radius:17px;color:#eef4ff;font-size:44px;font-weight:300;background:rgba(10,17,32,.3);box-shadow:inset 0 0 0 1px rgba(255,255,255,.08);animation:in-right .7s .08s both}.heading strong small{color:rgba(215,227,250,.48);font-size:8px;font-weight:700;letter-spacing:.11em}.work-grid{display:grid;gap:18px;margin-top:48px}.work-card{display:grid;grid-template-columns:.86fr 1.14fr;min-height:310px;overflow:hidden;border-radius:18px;animation:rise .8s .14s both}.work-card+.work-card{animation-delay:.25s}.copy{padding:31px;display:flex;flex-direction:column;justify-content:center}.copy h2{margin:29px 0 14px;font-size:clamp(31px,4vw,49px);line-height:1.05;letter-spacing:-.045em}.copy p{max-width:510px;color:rgba(242,245,251,.62);font-size:14px;line-height:1.8}.copy a{width:max-content;margin-top:30px;color:#e2ecff;font-size:12px;font-weight:750}.visual{position:relative;min-height:310px;display:grid;place-items:center;overflow:hidden;background:linear-gradient(145deg,rgba(55,72,104,.48),rgba(7,13,26,.45));border-right:1px solid rgba(215,229,255,.1)}.reverse .visual{border:0;border-left:1px solid rgba(215,229,255,.1);background:linear-gradient(145deg,rgba(16,31,48,.4),rgba(74,63,95,.4))}.visual>b{position:absolute;top:20px;left:22px;color:rgba(232,239,255,.18);font-size:58px;font-weight:300}.visual small{position:absolute;right:20px;bottom:17px;color:rgba(221,231,250,.36);font-size:8px;font-weight:700;letter-spacing:.14em}.visual i{font-style:normal}.ai>i{width:116px;height:116px;display:grid;place-items:center;border:1px solid rgba(198,218,255,.28);border-radius:50%;color:#dbe8ff;font-size:14px;font-weight:700;box-shadow:inset 0 0 30px rgba(176,204,255,.07)}.ai>em{position:absolute;bottom:67px;width:64px;height:24px;border-top:1px solid rgba(200,220,255,.45);font-style:normal;color:#c8dcff;text-align:center}.home>i{z-index:1;width:105px;height:105px;display:grid;place-items:center;border:1px solid rgba(212,226,255,.3);border-radius:29px;background:rgba(255,255,255,.045);color:#edf3ff;font-size:48px;font-weight:700;box-shadow:0 18px 45px rgba(0,0,0,.24)}.home>em{position:absolute;width:190px;height:190px;border:1px solid rgba(194,215,255,.13);border-radius:50%;animation:spin 18s linear infinite}.home>em:after{content:'';position:absolute;top:17px;left:24px;width:8px;height:8px;border-radius:50%;background:#b9cff7;box-shadow:0 0 14px #b9cff7}footer{margin-top:18px;padding:17px 3px 0;display:flex;justify-content:space-between;gap:30px;border-top:1px solid rgba(218,229,250,.13);color:rgba(215,226,247,.44);font-size:10px;letter-spacing:.12em}footer p{letter-spacing:0;text-align:right}@keyframes in-left{from{opacity:0;transform:translateX(-24px)}to{opacity:1;transform:none}}@keyframes in-right{from{opacity:0;transform:translateX(24px)}to{opacity:1;transform:none}}@keyframes rise{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}@keyframes spin{to{transform:rotate(360deg)}}
  @media(max-width:800px){.works{width:min(100% - 28px,650px)}.heading strong{position:static;width:100%;margin-top:24px;display:flex;align-items:center;justify-content:space-between}.work-card{grid-template-columns:1fr}.reverse .copy{order:2}.reverse .visual{order:1;border:0;border-bottom:1px solid rgba(215,229,255,.1)}.visual{min-height:235px;border:0;border-bottom:1px solid rgba(215,229,255,.1)}}@media(max-width:520px){.heading h1{font-size:44px}.work-grid{margin-top:30px}.copy{padding:25px 21px}.copy h2{font-size:33px}footer{align-items:flex-start}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
