---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---
<BaseLayout title="作品">
  <section class="works-page">
    <header class="page-header">
      <h1 class="page-title">作品 <span class="count">{projects.length}</span></h1>
      <p class="lead">自己折腾的一些东西，能打开、能用。</p>
    </header>

    <div class="works-list">
      {projects.map((project, index) => (
        <article class="work-card glass">
          <span class="work-index">{String(index + 1).padStart(2, '0')}</span>
          <div class="work-body">
            <h2 class="work-name">{project.name} <span>{project.nameSuffix}</span></h2>
            <p class="work-desc">{project.description}</p>
            <div class="work-tags">
              {project.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>

    <p class="works-note">就这些，做完新的再加。</p>
  </section>
</BaseLayout>

<style>
  .works-page {
    width: min(860px, calc(100% - 40px));
    margin: 0 auto;
    padding: 20px 0 80px;
  }

  .page-header {
    margin-bottom: 34px;
    animation: page-in .7s cubic-bezier(.2,.8,.2,1) both;
  }

  .page-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0;
    font-size: clamp(36px, 5vw, 48px);
    font-weight: 700;
    letter-spacing: -.03em;
    color: #fff;
  }

  .count {
    font-size: .45em;
    font-weight: 600;
    color: rgba(169, 200, 255, .6);
  }

  .lead {
    margin: 12px 0 0;
    color: rgba(233, 238, 248, .6);
    font-size: 15px;
  }

  .works-list {
    display: grid;
    gap: 14px;
  }

  .work-card {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 18px;
    align-items: start;
    padding: 24px 26px;
    border-radius: 16px;
    animation: card-in .7s cubic-bezier(.2,.8,.2,1) both;
  }

  .work-card + .work-card {
    animation-delay: .12s;
  }

  .work-index {
    padding-top: 5px;
    color: rgba(232, 239, 255, .3);
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .work-body {
    display: grid;
    gap: 10px;
  }

  .work-name {
    margin: 0;
    font-size: clamp(20px, 2.6vw, 24px);
    font-weight: 700;
    letter-spacing: -.02em;
    color: #fff;
  }

  .work-name span {
    color: #b9caf1;
    font-size: .72em;
    font-weight: 600;
  }

  .work-desc {
    margin: 0;
    max-width: 560px;
    color: rgba(242, 245, 251, .62);
    font-size: 14px;
    line-height: 1.75;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 2px;
  }

  .tag {
    padding: 4px 11px;
    border-radius: 6px;
    background: rgba(169, 200, 255, .1);
    color: rgba(169, 200, 255, .85);
    font-size: 11px;
    font-weight: 600;
  }

  .works-note {
    margin: 26px 0 0;
    color: rgba(233, 238, 248, .42);
    font-size: 13px;
  }

  @keyframes page-in {
    from { opacity: 0; transform: translateY(-14px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes card-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 640px) {
    .works-page {
      width: min(100% - 28px, 640px);
      padding: 10px 0 60px;
    }

    .work-card {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 20px;
    }

    .work-index {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .01ms !important;
    }
  }
</style>
