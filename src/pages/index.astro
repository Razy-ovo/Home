---
import BaseLayout from '../layouts/BaseLayout.astro';
import { nickname, motto, socialLinks } from '../data/profile';
import Clock from '../components/widgets/Clock.svelte';
import { Icon } from 'astro-icon/components';
---

<BaseLayout title="首页">
  <div class="home" id="home">
    <section class="main-grid" aria-labelledby="hero-title">
      <div class="left-col">
        <div class="identity-row">
          <div class="avatar-ring"><img src="https://q.qlogo.cn/headimg_dl?dst_uin=179097240&amp;spec=640&amp;img_type=jpg" alt="星辰的头像" /></div>
          <div>
            <p class="eyebrow">PERSONAL SPACE</p>
            <h1 id="hero-title">{nickname} <small>/ Razy</small></h1>
            <p class="motto">{motto}</p>
          </div>
        </div>
        <div class="intro-card glass markdown-content" id="about">
          <div>
            <p>你好，我是<strong>星辰</strong>。平时学习、制作网页，也在探索 AI 对话和更舒服的交互体验。</p>
            <p>我喜欢把零散的灵感，做成真正能打开、能使用的页面。</p>
            <blockquote>我在学习中持续制作网页，也会尝试把 AI 能力接入真实的日常场景。</blockquote>
          </div>
        </div>
        <div class="social-row" aria-label="联系方式">
          {socialLinks.map((link) => (
            <a href={link.url} class="glass-btn" title={link.label} target={link.url.startsWith('mailto:') ? undefined : '_blank'} rel="noopener">
              {link.label === '邮箱' ? <Icon name="fa6-solid:envelope" /> : <Icon name="fa6-brands:qq" />}
            </a>
          ))}
          <a href="/projects/" class="project-link">查看作品 <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="right-col" aria-label="当前方向">
        <section class="clock-card glass" aria-label="当前时间"><Clock client:load /></section>
        <div class="stats-grid">
          <article class="stat-card glass"><span>当前身份</span><strong>高中生</strong></article>
          <article class="stat-card glass"><span>当前技术</span><strong>Astro + Svelte</strong></article>
          <article class="stat-card glass"><span>作品数量</span><strong>2 个</strong></article>
        </div>
        <section class="quote-card glass"><p>在代码与星光之间，构筑无限可能。</p></section>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .home { width: min(940px, calc(100% - 40px)); margin: 0 auto; }
  .main-grid { display: grid; grid-template-columns: 1.07fr .93fr; align-items: center; gap: 46px; min-height: 515px; }
  .left-col { display: flex; flex-direction: column; gap: 22px; animation: enter-left .8s cubic-bezier(.2,.8,.2,1) both; }
  .right-col { display: grid; gap: 12px; animation: enter-right .85s .12s cubic-bezier(.2,.8,.2,1) both; }
  .identity-row { display: flex; align-items: center; gap: 19px; }
  .avatar-ring { display: grid; width: 96px; height: 96px; place-items: center; flex: 0 0 96px; overflow: hidden; isolation: isolate; line-height: 0; border: 1px solid rgba(255,255,255,.7); border-radius: 50%; background: #1c2434; box-shadow: inset 0 0 24px rgba(255,255,255,.15), 0 8px 28px rgba(0,0,0,.35); }
  .avatar-ring img { display: block; width: 100%; height: 100%; max-width: none; border-radius: inherit; object-fit: cover; object-position: center; transform: scale(1.2); }
  .eyebrow { margin: 0; color: #b8c9eb; font-size: 11px; font-weight: 700; letter-spacing: .12em; }
  h1 { margin: 5px 0 2px; font-size: clamp(36px, 4vw, 51px); line-height: 1.07; letter-spacing: -.04em; }
  h1 small { color: #b9caf1; font-size: .52em; font-weight: 600; letter-spacing: -.01em; }
  .motto { margin: 7px 0 0; color: rgba(233,238,248,.65); font-size: 14px; }
  .glass { border: 1px solid rgba(255,255,255,.17); background: linear-gradient(140deg, rgba(32,37,48,.65), rgba(16,20,29,.43)); box-shadow: 0 20px 54px rgba(0,0,0,.2), inset 0 1px 0 rgba(255,255,255,.08); backdrop-filter: blur(16px) saturate(120%); -webkit-backdrop-filter: blur(16px) saturate(120%); }
  .intro-card { padding: 23px 25px; border-radius: 16px; }
  .markdown-content :global(p) { margin: 0; color: rgba(242,245,251,.76); font-size: 14px; line-height: 1.75; }
  .markdown-content :global(p + p) { margin-top: 10px; }
  .markdown-content :global(strong) { color: #f4f7ff; font-weight: 750; }
  .markdown-content :global(blockquote) { margin: 14px 0 0; padding: 8px 0 8px 14px; border-left: 2px solid rgba(169,200,255,.55); color: rgba(242,245,251,.54); font-size: 13px; line-height: 1.7; }
  .social-row { display: flex; align-items: center; gap: 10px; }
  .glass-btn { display: grid; width: 41px; height: 41px; place-items: center; border: 1px solid rgba(255,255,255,.18); border-radius: 50%; background: rgba(8,11,18,.25); color: #fff; font-size: 16px; transition: transform .25s ease, background .25s ease; }
  .glass-btn :global(svg) { width: 17px; height: 17px; }
  .glass-btn:hover { transform: translateY(-3px); background: rgba(255,255,255,.15); }
  .project-link { margin-left: 5px; color: #dbe8ff; font-size: 13px; font-weight: 650; }
  .project-link span, .project-card b { margin-left: 5px; color: #a9c8ff; }
  .clock-card { min-height: 136px; padding: 14px 20px; border-radius: 16px; }
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .stat-card { min-height: 104px; padding: 17px; border-radius: 14px; }
  .stat-card span { display: block; color: rgba(242,245,251,.48); font-size: 11px; }
  .stat-card strong { display: block; margin-top: 17px; font-size: clamp(16px, 2vw, 21px); line-height: 1.1; white-space: nowrap; }
  .quote-card { padding: 21px 24px; border-radius: 16px; }
  .quote-card p { margin: 0; color: rgba(255,255,255,.84); font-size: 16px; }
  @keyframes enter-left { from { opacity: 0; transform: translateX(-24px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes enter-right { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes card-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 768px) { .home { width: min(100% - 28px, 560px); } .main-grid { grid-template-columns: 1fr; gap: 14px; min-height: 0; padding-top: 20px; } .avatar-ring { width: 78px; height: 78px; flex-basis: 78px; } .stats-grid { gap: 8px; } .stat-card { padding: 13px 11px; } .stat-card strong { margin-top: 13px; font-size: 15px; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } }
</style>
