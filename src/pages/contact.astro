---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';

const email = 'razy-ovo@outlook.com';
const qqUrl = 'https://qm.qq.com/q/1oIg7qIYzm';
---

<BaseLayout title="联系">
  <div class="inner-page contact-page">
    <div class="contact-layout">
      <section class="contact-side" aria-labelledby="contact-title">
        <header class="page-heading">
          <p class="eyebrow">CONTACT / 保持联系</p>
          <h1 id="contact-title">有想法，<br /><span>可以和我聊聊。</span></h1>
          <p>页面、工具，或者关于 AI 的小想法，都可以通过下面的方式找到我。</p>
        </header>

        <div class="contact-list">
          <a class="contact-item glass" href={`mailto:${email}`}>
            <span class="contact-icon"><Icon name="fa6-solid:envelope" /></span>
            <span class="contact-copy">
              <small>邮箱</small>
              <strong>{email}</strong>
            </span>
            <span class="contact-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="contact-item glass" href={qqUrl} target="_blank" rel="noreferrer">
            <span class="contact-icon"><Icon name="fa6-brands:qq" /></span>
            <span class="contact-copy">
              <small>QQ</small>
              <strong>添加 QQ 联系我</strong>
            </span>
            <span class="contact-arrow" aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="contact-note glass">
          <span class="note-dot" aria-hidden="true"></span>
          <div>
            <small>OPEN CHANNEL</small>
            <p>收到消息后，我会尽量回复。</p>
          </div>
        </div>
      </section>

      <section class="signal glass" aria-labelledby="signal-title">
        <div class="signal-head">
          <div>
            <p class="eyebrow"><span class="signal-dot" aria-hidden="true"></span> SIGNAL TRANSMISSION</p>
            <h2 id="signal-title">发送一条星际信号</h2>
          </div>
          <span class="api-state">API READY</span>
        </div>
        <p class="signal-intro">把来意、联系方式和想说的话写进信号舱，我会收到后认真查看。</p>

        <form class="signal-form" id="signalForm">
          <div class="form-row">
            <label>
              <span>信号标题 <b>*</b></span>
              <input id="pushTitle" name="title" type="text" maxlength="80" placeholder="例如：想和你聊聊网页制作" required />
            </label>
            <label>
              <span>你的称呼 <b>*</b></span>
              <input id="pushName" name="name" type="text" maxlength="40" placeholder="怎么称呼你" required />
            </label>
          </div>
          <div class="form-row">
            <label>
              <span>邮箱</span>
              <input id="pushEmail" name="email" type="email" maxlength="100" placeholder="name@example.com" />
            </label>
            <label>
              <span>QQ / 微信 / 其他</span>
              <input id="pushContact" name="contact" type="text" maxlength="80" placeholder="至少填写一种联系方式" />
            </label>
          </div>
          <label>
            <span>信号内容 <b>*</b></span>
            <textarea id="pushContent" name="content" maxlength="1000" rows="6" placeholder="写下你想说的话..." required></textarea>
            <small class="char-hint" id="charHint">0 / 1000</small>
          </label>
          <div class="form-actions">
            <p class="form-status" id="pushStatus" role="status" aria-live="polite"></p>
            <button id="pushBtn" type="submit">发送信号 <span aria-hidden="true">↗</span></button>
          </div>
        </form>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  const PUSH_API = 'https://xizhi.qqoq.net/XZd391475ee20fae37c6195745e1834103.send';
  const form = document.querySelector('#signalForm');
  const titleInput = document.querySelector('#pushTitle');
  const nameInput = document.querySelector('#pushName');
  const emailInput = document.querySelector('#pushEmail');
  const contactInput = document.querySelector('#pushContact');
  const contentInput = document.querySelector('#pushContent');
  const charHint = document.querySelector('#charHint');
  const status = document.querySelector('#pushStatus');
  const button = document.querySelector('#pushBtn');

  if (form && titleInput && nameInput && emailInput && contactInput && contentInput && charHint && status && button) {
    contentInput.addEventListener('input', () => {
      charHint.textContent = `${contentInput.value.length} / 1000`;
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const title = titleInput.value.trim();
      const name = nameInput.value.trim();
      const emailValue = emailInput.value.trim();
      const contact = contactInput.value.trim();
      const content = contentInput.value.trim();

      if (!title || !name || !content) {
        status.textContent = '请先填写带 * 的内容。';
        status.className = 'form-status error';
        return;
      }
      if (!emailValue && !contact) {
        status.textContent = '邮箱或其他联系方式至少填写一种。';
        status.className = 'form-status error';
        return;
      }

      button.disabled = true;
      status.textContent = '正在发送信号...';
      status.className = 'form-status';
      const message = [
        `称呼：${name}`,
        `邮箱：${emailValue || '未填写'}`,
        `其他联系方式：${contact || '未填写'}`,
        '',
        content,
      ].join('\n');
      const beacon = new Image();
      beacon.onload = () => {
        status.textContent = '信号已送达，谢谢你的留言。';
        status.className = 'form-status success';
        form.reset();
        charHint.textContent = '0 / 1000';
        button.disabled = false;
      };
      beacon.onerror = () => {
        status.textContent = '发送失败，请直接通过邮箱联系我。';
        status.className = 'form-status error';
        button.disabled = false;
      };
      beacon.src = `${PUSH_API}?title=${encodeURIComponent(title)}&content=${encodeURIComponent(message)}&_t=${Date.now()}`;
    });
  }
</script>

<style>
  .inner-page { width: min(1100px, calc(100% - 40px)); margin: 0 auto; }
  .contact-page { padding-top: 12px; }
  .contact-layout { display: grid; grid-template-columns: minmax(280px, .78fr) minmax(420px, 1.22fr); gap: 18px; align-items: start; }
  .contact-side { display: grid; gap: 14px; }
  .page-heading { padding: 18px 0 12px; animation: page-in .7s cubic-bezier(.2,.8,.2,1) both; }
  .eyebrow { display: flex; align-items: center; gap: 9px; color: #b8c9eb; font-size: 11px; font-weight: 700; letter-spacing: .12em; }
  .page-heading h1 { margin: 20px 0 18px; font-size: clamp(44px, 5.3vw, 72px); line-height: 1.03; letter-spacing: -.045em; }
  .page-heading h1 span { color: #b9caf1; }
  .page-heading > p:last-child { max-width: 400px; color: rgba(242,245,251,.64); font-size: 15px; line-height: 1.8; }
  .contact-list { display: grid; gap: 12px; }
  .contact-item { min-height: 74px; padding: 12px 16px; display: grid; grid-template-columns: 34px 1fr auto; gap: 11px; align-items: center; border-radius: 17px; transition: border-color .22s ease, background .22s ease, transform .22s ease; animation: contact-item-in .72s .18s cubic-bezier(.2,.8,.2,1) both; }
  .contact-item + .contact-item { animation-delay: .3s; }
  .contact-item:hover { transform: translateX(5px); border-color: rgba(194,216,255,.42); background: rgba(34,45,70,.66); }
  .contact-icon { width: 32px; height: 32px; display: grid; place-items: center; border: 1px solid rgba(210,224,255,.2); border-radius: 8px; color: #c9dcff; font-size: 14px; background: rgba(255,255,255,.07); }
  .contact-copy { display: grid; gap: 4px; min-width: 0; }
  .contact-copy small, .contact-note small { color: rgba(211,223,247,.52); font-size: 10px; letter-spacing: .12em; }
  .contact-copy strong { overflow-wrap: anywhere; color: #f3f6ff; font-size: 13px; font-weight: 650; }
  .contact-arrow { color: #a9c8ff; font-size: 22px; transition: transform .22s ease; }
  .contact-item:hover .contact-arrow { transform: translate(3px, -3px); }
  .contact-note { min-height: 84px; padding: 18px 20px; display: flex; align-items: center; gap: 12px; border-radius: 17px; animation: contact-item-in .72s .42s cubic-bezier(.2,.8,.2,1) both; }
  .note-dot, .signal-dot { display: inline-block; flex: 0 0 auto; width: 8px; height: 8px; border-radius: 50%; background: #8fe0d5; box-shadow: 0 0 0 5px rgba(143,224,213,.1), 0 0 16px rgba(143,224,213,.7); }
  .contact-note p { margin-top: 5px; color: rgba(242,245,251,.68); font-size: 13px; }
  .signal { padding: 26px; border-radius: 17px; animation: card-in .8s .12s cubic-bezier(.2,.8,.2,1) both; }
  .signal-head { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; }
  .signal-head .eyebrow { color: #c0d0ef; }
  .signal-dot { width: 7px; height: 7px; box-shadow: 0 0 0 4px rgba(143,224,213,.1), 0 0 13px rgba(143,224,213,.7); }
  .api-state { padding-top: 2px; color: rgba(211,223,247,.48); font-size: 10px; font-weight: 700; letter-spacing: .12em; white-space: nowrap; }
  .signal h2 { margin-top: 19px; font-size: clamp(30px, 3.4vw, 48px); line-height: 1.05; letter-spacing: -.04em; }
  .signal-intro { max-width: 470px; margin: 14px 0 25px; color: rgba(242,245,251,.62); font-size: 13px; line-height: 1.7; }
  .signal-form { display: grid; gap: 14px; }
  .form-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  label { display: grid; gap: 7px; }
  label > span { color: rgba(226,235,253,.72); font-size: 11px; font-weight: 650; }
  label b { color: #bad1ff; font-weight: 500; }
  input, textarea { width: 100%; border: 1px solid rgba(199,218,255,.16); border-radius: 10px; outline: none; background: rgba(4,10,22,.34); color: #f4f7ff; font: inherit; font-size: 13px; transition: border-color .2s ease, background .2s ease, box-shadow .2s ease; }
  input { height: 42px; padding: 0 12px; }
  textarea { min-height: 118px; padding: 11px 12px; resize: vertical; }
  input::placeholder, textarea::placeholder { color: rgba(222,231,248,.33); }
  input:focus, textarea:focus { border-color: rgba(169,200,255,.62); background: rgba(8,15,31,.56); box-shadow: 0 0 0 3px rgba(169,200,255,.08); }
  .char-hint { display: block; margin-top: -2px; color: rgba(222,231,248,.36); text-align: right; font-size: 10px; }
  .form-actions { display: flex; min-height: 40px; align-items: center; justify-content: space-between; gap: 12px; }
  .form-status { min-height: 20px; color: rgba(222,231,248,.58); font-size: 11px; line-height: 1.6; }
  .form-status.success { color: #9de4d5; }
  .form-status.error { color: #f0b0bb; }
  button { min-width: 122px; height: 40px; padding: 0 15px; border: 1px solid rgba(210,227,255,.28); border-radius: 10px; background: linear-gradient(135deg, rgba(187,211,255,.25), rgba(111,143,197,.24)); color: #f5f8ff; cursor: pointer; font: inherit; font-size: 12px; font-weight: 700; transition: background .2s ease, transform .2s ease, border-color .2s ease; }
  button span { margin-left: 5px; font-size: 16px; }
  button:hover:not(:disabled) { transform: translateY(-2px); border-color: rgba(210,227,255,.56); background: linear-gradient(135deg, rgba(203,222,255,.34), rgba(127,161,220,.32)); }
  button:disabled { opacity: .5; cursor: wait; }
  @keyframes page-in { from { opacity: 0; transform: translateX(-22px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes card-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes contact-item-in { from { opacity: 0; transform: translateX(-18px); } to { opacity: 1; transform: translateX(0); } }
  @media (max-width: 820px) {
    .inner-page { width: min(100% - 28px, 600px); }
    .contact-page { padding-top: 4px; }
    .contact-layout { grid-template-columns: 1fr; }
    .page-heading { padding-top: 10px; }
    .signal { padding: 22px 18px; }
  }
  @media (max-width: 520px) {
    .page-heading h1 { font-size: 42px; }
    .form-row { grid-template-columns: 1fr; }
    .signal-head { display: block; }
    .api-state { display: block; margin-top: 10px; }
    .form-actions { align-items: flex-end; flex-direction: column; }
    button { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>
