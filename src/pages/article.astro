---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0));

const articleTitle = (entry: typeof articles[number]) => entry.data.title ?? entry.id.split('/').at(-1)?.replace(/[-_]/g, ' ') ?? '未命名文章';
---

<BaseLayout title="文章">
  <section class="articles-page">
    <header class="page-header">
      <a href="/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        返回首页
      </a>
      <div class="header-content">
        <h1 class="page-title">
          文章
          {articles.length > 0 && (
            <span class="article-count">{articles.length}</span>
          )}
        </h1>
      </div>
    </header>

    {articles.length ? (
      <div class="article-grid">
        {articles.map((article) => (
          <article class="article-card">
            <a href={`/article/${article.id}/`} class="card-link">
              <div class="card-header">
                <time class="article-date" datetime={article.data.pubDate?.toISOString()}>
                  {article.data.pubDate?.toLocaleDateString('zh-CN', { 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                  })}
                </time>
                {article.data.tags && article.data.tags.length > 0 && (
                  <div class="article-tags">
                    {article.data.tags.slice(0, 2).map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
              
              <h2 class="article-title">{articleTitle(article)}</h2>
              
              {article.data.description && (
                <p class="article-excerpt">{article.data.description}</p>
              )}
              
              <div class="card-footer">
                <span class="read-more">
                  阅读全文
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <div class="empty-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
        </div>
        <h2 class="empty-title">还没有文章</h2>
        <p class="empty-description">在 <code>src/content/articles/</code> 目录下创建 Markdown 文件来发布你的第一篇文章。</p>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  /* 页面容器 */
  .articles-page {
    width: calc(100% - 160px);
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 0 80px;
  }
  
  /* 页面头部 */
  .page-header {
    margin-bottom: 32px;
  }
  
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    color: rgba(200, 215, 240, 0.6);
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  
  .back-link:hover {
    color: #fff;
  }
  
  .back-link svg {
    width: 16px;
    height: 16px;
  }
  
  .header-content {
    position: relative;
  }
  
  .page-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0;
    font-size: clamp(36px, 5vw, 48px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #ffffff;
  }
  
  .article-count {
    font-size: 0.45em;
    font-weight: 600;
    color: rgba(169, 200, 255, 0.6);
  }
  
  /* 文章网格 */
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 24px;
  }
  
  /* 文章卡片 */
  .article-card {
    position: relative;
    height: 100%;
  }
  
  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 32px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(30, 42, 69, 0.4), rgba(12, 19, 36, 0.35));
    border: 1px solid rgba(216, 230, 255, 0.12);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card-link:hover {
    background: linear-gradient(135deg, rgba(40, 52, 79, 0.5), rgba(16, 26, 48, 0.45));
    border-color: rgba(216, 230, 255, 0.25);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }
  
  /* 卡片头部 */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
  }
  
  .article-date {
    font-size: 13px;
    color: rgba(200, 215, 240, 0.5);
    font-weight: 500;
  }
  
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  
  .tag {
    padding: 5px 12px;
    border-radius: 6px;
    background: rgba(169, 200, 255, 0.1);
    color: rgba(169, 200, 255, 0.85);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  
  /* 文章标题 */
  .article-title {
    margin: 0 0 12px;
    font-size: clamp(20px, 3vw, 24px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #ffffff;
  }
  
  /* 文章摘要 */
  .article-excerpt {
    margin: 0 0 20px;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(200, 215, 240, 0.65);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* 卡片底部 */
  .card-footer {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(200, 215, 240, 0.08);
  }
  
  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 500;
    color: rgba(169, 200, 255, 0.8);
    transition: all 0.2s ease;
  }
  
  .card-link:hover .read-more {
    color: rgba(169, 200, 255, 1);
    gap: 10px;
  }
  
  .read-more svg {
    width: 16px;
    height: 16px;
  }
  
  /* 空状态 */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 40px;
    text-align: center;
  }
  
  .empty-icon {
    margin-bottom: 24px;
    color: rgba(200, 215, 240, 0.3);
  }
  
  .empty-icon svg {
    width: 64px;
    height: 64px;
  }
  
  .empty-title {
    margin: 0 0 12px;
    font-size: 24px;
    font-weight: 700;
    color: rgba(200, 215, 240, 0.8);
  }
  
  .empty-description {
    margin: 0;
    max-width: 480px;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(200, 215, 240, 0.5);
  }
  
  .empty-description code {
    padding: 3px 10px;
    border-radius: 6px;
    background: rgba(169, 200, 255, 0.1);
    color: rgba(169, 200, 255, 0.85);
    font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
    font-size: 0.9em;
    font-weight: 500;
  }
  
  /* 响应式 */
  @media (max-width: 1024px) {
    .articles-page {
      width: calc(100% - 100px);
    }
    
    .article-grid {
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
    }
  }
  
  @media (max-width: 768px) {
    .articles-page {
      width: calc(100% - 60px);
      padding: 16px 0 60px;
    }
    
    .back-link {
      margin-bottom: 20px;
    }
    
    .page-header {
      margin-bottom: 28px;
    }
    
    .page-title {
      font-size: clamp(28px, 7vw, 40px);
      gap: 10px;
    }
    
    .article-count {
      font-size: 0.4em;
    }
    
    .article-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    
    .card-link {
      padding: 24px;
    }
    
    .article-title {
      font-size: 20px;
    }
    
    .article-excerpt {
      font-size: 14px;
    }
  }
  
  @media (max-width: 480px) {
    .articles-page {
      width: calc(100% - 32px);
    }
    
    .page-title {
      font-size: 36px;
    }
    
    .card-link {
      padding: 20px;
    }
    
    .empty-state {
      padding: 60px 20px;
    }
  }
</style>
