---
// NavBar.astro — 导航栏

import { site } from "../../data/site";
---

<div class="nav-wrap">
  <nav class="navbar glass" aria-label="主导航">
    <a href="/" class="nav-logo" aria-label="首页"><span>R</span>{site.name}</a>
    <div class="nav-links">
      <a href="/">首页</a>
      <a href="/about/">关于</a>
      <a href="/projects/">作品</a>
      <a href="/article/">文章</a>
      <a href="/contact/">联系</a>
    </div>
  </nav>
</div>

<style>
  /* 导航栏容器 */
  .nav-wrap {
    position: fixed;
    top: 20px;
    left: 50%;
    width: min(1160px, calc(100% - 40px));
    transform: translateX(-50%);
    z-index: 100;
  }
  .navbar {
    min-height: 62px;
    padding: 10px 15px 10px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: 21px;
    animation: nav-in .7s cubic-bezier(.2,.8,.2,1) both;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: .02em;
    color: #fff;
    white-space: nowrap;
  }
  .nav-logo span {
    display: grid;
    width: 27px;
    height: 27px;
    place-items: center;
    border: 1px solid rgba(255,255,255,.28);
    border-radius: 9px;
    background: rgba(255,255,255,.09);
    color: #a9c8ff;
    font-size: .75rem;
  }
  .nav-links {
    display: flex;
    gap: 3px;
  }
  .nav-links a {
    padding: 8px 11px;
    border-radius: 11px;
    color: rgba(237,242,252,.7);
    font-size: .88rem;
    transition: background .2s ease, color .2s ease;
  }
  .nav-links a:hover,
  .nav-links a:focus-visible { color: #fff; background: rgba(255,255,255,.12); }
  @keyframes nav-in { from { opacity: 0; transform: translateY(-12px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 768px) {
    .nav-wrap { top: 10px; width: calc(100% - 28px); }
    .navbar { min-height: 54px; padding: 8px 10px 8px 14px; border-radius: 18px; }
    .nav-logo { font-size: .9rem; }
    .nav-logo span { display: none; }
    .nav-links { gap: 0; }
    .nav-links a { padding: 7px 7px; font-size: .74rem; }
  }
</style>
