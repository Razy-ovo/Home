---
// NavBar.astro — 导航栏

import { site } from "../../data/site";
---

<div class="nav-wrap">
  <nav class="navbar glass" aria-label="主导航">
    <a href="/" class="nav-logo" aria-label="首页"><span>R</span>{site.name}</a>
    <button class="hamburger" aria-label="菜单" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="nav-links">
      <a href="/">首页</a>
      <a href="/about/">关于</a>
      <a href="/projects/">作品</a>
      <a href="/article/">文章</a>
      <a href="/friends/">友链</a>
      <a href="/contact/">联系</a>
    </div>
  </nav>
</div>

<script>
  // 防止 Swup 导航时脚本重复执行导致 2N 个监听器相互抵消
  if (!window.__navMenuReady) {
    window.__navMenuReady = true;

    function closeMenu(h, n) {
      if (h) { h.classList.remove('active'); h.setAttribute('aria-expanded', 'false'); }
      if (n) n.classList.remove('active');
    }

    document.addEventListener('click', (e) => {
      const hamburger = document.querySelector('.hamburger');
      const navLinks = document.querySelector('.nav-links');

      // 点击菜单中的链接 → 先关闭菜单，再让 Swup 导航
      if (e.target.closest('.nav-links a[href]')) {
        closeMenu(hamburger, navLinks);
        return;
      }

      // 点击汉堡按钮 → 开关菜单
      if (e.target.closest('.hamburger')) {
        if (!hamburger || !navLinks) return;
        const open = hamburger.getAttribute('aria-expanded') === 'true';
        if (open) {
          closeMenu(hamburger, navLinks);
        } else {
          hamburger.setAttribute('aria-expanded', 'true');
          hamburger.classList.add('active');
          navLinks.classList.add('active');
        }
        return;
      }

      // 点击导航栏外部 → 关闭菜单
      if (!e.target.closest('.navbar')) {
        closeMenu(hamburger, navLinks);
      }
    });
  }
</script>

<style>
  /* 导航栏容器 */
  .nav-wrap {
    position: fixed;
    top: 20px;
    left: 50%;
    width: min(1160px, calc(100% - 40px));
    transform: translateX(-50%);
    z-index: 100;
  }
  .navbar {
    min-height: 62px;
    padding: 10px 15px 10px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: 21px;
    animation: nav-in .7s cubic-bezier(.2,.8,.2,1) both;
    position: relative;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: .02em;
    color: #fff;
    white-space: nowrap;
  }
  .nav-logo span {
    display: grid;
    width: 27px;
    height: 27px;
    place-items: center;
    border: 1px solid rgba(255,255,255,.28);
    border-radius: 9px;
    background: rgba(255,255,255,.09);
    color: #a9c8ff;
    font-size: .75rem;
  }
  .nav-links {
    display: flex;
    gap: 3px;
  }
  .nav-links a {
    padding: 8px 11px;
    border-radius: 11px;
    color: rgba(237,242,252,.7);
    font-size: .88rem;
    transition: background .2s ease, color .2s ease;
  }
  .nav-links a:hover,
  .nav-links a:focus-visible { color: #fff; background: rgba(255,255,255,.12); }
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .hamburger span {
    width: 22px;
    height: 2px;
    background: rgba(237,242,252,.7);
    border-radius: 1px;
    transition: all .3s ease;
  }
  .hamburger.active span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger.active span:nth-child(2) {
    opacity: 0;
  }
  .hamburger.active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  @keyframes nav-in { from { opacity: 0; transform: translateY(-12px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 768px) {
    .nav-wrap { top: 10px; width: calc(100% - 28px); }
    .navbar { 
      min-height: 54px; 
      padding: 8px 14px; 
      border-radius: 18px;
    }
    .nav-logo { font-size: .9rem; flex-shrink: 0; }
    .nav-logo span { display: none; }
    .hamburger { display: flex; flex-shrink: 0; }
    .nav-links {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      gap: 0;
      flex-direction: column;
      background: rgba(6, 9, 18, .95);
      backdrop-filter: blur(10px);
      border-radius: 18px;
      overflow: hidden;
      max-height: 0;
      transition: max-height .3s cubic-bezier(.2,.8,.2,1);
    }
    .nav-links.active {
      max-height: 360px;
    }
    .nav-links a {
      padding: 13px 20px;
      font-size: .9rem;
      border-radius: 0;
      display: block;
      white-space: nowrap;
    }
    .nav-links a:first-child {
      padding-top: 21px;
    }
    .nav-links a:last-child {
      padding-bottom: 21px;
    }
    .nav-links a:hover {
      background: rgba(255,255,255,.08);
    }
  }
</style>
