---
// NavBar.astro — 导航栏

import { site } from "../../data/site";
---

<div class="nav-wrap">
  <nav class="navbar glass" aria-label="主导航">
    <a href="/" class="nav-logo" aria-label="首页"><span>R</span>{site.name}</a>
    <button class="hamburger" aria-label="菜单" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="nav-links">
      <a href="/">首页</a>
      <a href="/about/">关于</a>
      <a href="/projects/">作品</a>
      <a href="/article/">文章</a>
      <a href="/friends/">友链</a>
      <a href="/contact/">联系</a>
    </div>
  </nav>
</div>

<script>
  const hamburger = document.querySelector('.hamburger');
  const navLinks = document.querySelector('.nav-links');
  
  hamburger?.addEventListener('click', () => {
    const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
    hamburger.setAttribute('aria-expanded', (!isOpen).toString());
    hamburger.classList.toggle('active');
    navLinks?.classList.toggle('active');
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.navbar')) {
      hamburger?.classList.remove('active');
      navLinks?.classList.remove('active');
      hamburger?.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
  /* 导航栏容器 */
  .nav-wrap {
    position: fixed;
    top: 20px;
    left: 50%;
    width: min(1160px, calc(100% - 40px));
    transform: translateX(-50%);
    z-index: 100;
  }
  .navbar {
    min-height: 62px;
    padding: 10px 15px 10px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: 21px;
    animation: nav-in .7s cubic-bezier(.2,.8,.2,1) both;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: .02em;
    color: #fff;
    white-space: nowrap;
  }
  .nav-logo span {
    display: grid;
    width: 27px;
    height: 27px;
    place-items: center;
    border: 1px solid rgba(255,255,255,.28);
    border-radius: 9px;
    background: rgba(255,255,255,.09);
    color: #a9c8ff;
    font-size: .75rem;
  }
  .nav-links {
    display: flex;
    gap: 3px;
  }
  .nav-links a {
    padding: 8px 11px;
    border-radius: 11px;
    color: rgba(237,242,252,.7);
    font-size: .88rem;
    transition: background .2s ease, color .2s ease;
  }
  .nav-links a:hover,
  .nav-links a:focus-visible { color: #fff; background: rgba(255,255,255,.12); }
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .hamburger span {
    width: 22px;
    height: 2px;
    background: rgba(237,242,252,.7);
    border-radius: 1px;
    transition: all .3s ease;
  }
  .hamburger.active span:nth-child(1) {
    transform: rotate(45deg) translate(8px, 8px);
  }
  .hamburger.active span:nth-child(2) {
    opacity: 0;
  }
  .hamburger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }
  @keyframes nav-in { from { opacity: 0; transform: translateY(-12px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 768px) {
    .nav-wrap { top: 10px; width: calc(100% - 28px); }
    .navbar { 
      min-height: 54px; 
      padding: 8px 10px 8px 14px; 
      border-radius: 18px;
      flex-wrap: wrap;
    }
    .nav-logo { font-size: .9rem; }
    .nav-logo span { display: none; }
    .hamburger { display: flex; }
    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      gap: 0;
      width: 100%;
      flex-direction: column;
      background: rgba(6, 9, 18, .95);
      backdrop-filter: blur(10px);
      border-radius: 0 0 18px 18px;
      padding: 10px 0;
      margin-top: 8px;
      max-height: 0;
      overflow: hidden;
      transition: max-height .3s ease;
    }
    .nav-links.active {
      max-height: 300px;
    }
    .nav-links a {
      padding: 12px 20px;
      font-size: .9rem;
      border-radius: 0;
      display: block;
    }
    .nav-links a:hover {
      background: rgba(255,255,255,.08);
    }
  }
</style>
